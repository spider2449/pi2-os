# Copy to .env (gitignored) and fill in the tokens.
# Start with:
#   docker --context pi compose --env-file examples/gitea-sync/.env \
#     -f examples/gitea-sync/compose.yaml up -d

# Gitea API token with the write:repository scope (required).
GITEA_TOKEN=

# GitHub PAT with Contents: Read, needed for private repositories.
GITHUB_TOKEN=
